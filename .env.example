# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.
POSTGRES_USER=sazon
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=sazon

# Carga los CSV del paquete al arrancar (true/false)
SEED_ON_START=true
# Existencias a partir de las cuales se emite la alerta de stock crítico
STOCK_CRITICO=5

# Solo para correr la API fuera de Docker (la que usa docker-compose se arma sola)
# DATABASE_URL=sqlite:///./sazon.db
