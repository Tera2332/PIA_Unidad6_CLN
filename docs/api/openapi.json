  "components": {
    "schemas": {
      "AjusteIn": {
        "properties": {
          "platillo_id": {
            "type": "string",
            "title": "Platillo Id",
            "examples": [
              "PED-P001"
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "entrada",
              "merma"
            ],
            "title": "Tipo"
          },
          "cantidad": {
            "type": "integer",
            "title": "Cantidad",
            "examples": [
              5
            ]
          },
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "description": "Obligatorio cuando el tipo es merma",
            "default": ""
          },
          "usuario": {
            "type": "string",
            "title": "Usuario",
            "default": "encargado"
          }
        },
        "type": "object",
        "required": [
          "platillo_id",
          "tipo",
          "cantidad"
        ],
        "title": "AjusteIn"
      },
      "CancelarIn": {
        "properties": {
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "examples": [
              "El cliente ya no quiso esperar"
            ]
          },
          "usuario": {
            "type": "string",
            "title": "Usuario",
            "examples": [
              "encargado1"
            ]
          },
          "rol": {
            "type": "string",
            "title": "Rol",
            "description": "Solo Encargado o Gerente pueden cancelar",
            "examples": [
              "Encargado"
            ]
          }
        },
        "type": "object",
        "required": [
          "motivo",
          "usuario",
          "rol"
        ],
        "title": "CancelarIn"
      },
      "ClienteOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "es_preferente": {
            "type": "boolean",
            "title": "Es Preferente"
          },
          "activo": {
            "type": "boolean",
            "title": "Activo"
          },
          "ciudad": {
            "type": "string",
            "title": "Ciudad"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "es_preferente",
          "activo",
          "ciudad"
        ],
        "title": "ClienteOut"
      },
      "ErrorOut": {
